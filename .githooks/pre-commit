#!/usr/bin/env bash
# Keep the generated CC artifact (lib/repo-review.js) in sync with its source
# (lib/engine.mjs) at commit time, so a forgotten rebuild can't commit drift.
# CI re-verifies with `scripts/build-cc.mjs --check`; this is the local guard.
#
# Enable once per clone:  git config core.hooksPath .githooks
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

# find node; fall back to the project's conda env if it is not on PATH
if ! command -v node >/dev/null 2>&1; then
  base="$(conda info --base 2>/dev/null)" || true
  if [ -n "${base:-}" ] && [ -f "$base/etc/profile.d/conda.sh" ]; then
    . "$base/etc/profile.d/conda.sh"
    conda activate repo-review 2>/dev/null || true
  fi
fi
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found - skipped artifact regen (CI will verify)." >&2
  exit 0
fi

artifact=plugins/repo-review/lib/repo-review.js
node scripts/build-cc.mjs >/dev/null
if ! git diff --quiet -- "$artifact"; then
  git add -- "$artifact"
  echo "pre-commit: regenerated $artifact from engine.mjs and staged it." >&2
fi
exit 0
